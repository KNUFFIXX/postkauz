# PostKauz: MCP über HTTP (mcp --http, A03 S3.5, ADR-010), Vorlage für einen
# VPS. Dieser Dienst kennt kein Postfachpasswort (ADR-009): kein
# LoadCredential=, und der MCP-Prozess bekommt einen Secrets-Speicher, der
# jeden Zugriff verweigert. Er lauscht nur auf 127.0.0.1:8787 ([http]
# listen); TLS und das private Netz kommen von tailscale serve. Anleitung:
# docs/betrieb.md, Abschnitt 4.4.
#
# Derselbe Nutzer wie der Sync-Dienst (postkauz), weil beide dieselbe
# Datenbank und dieselben Blobs nutzen und PostKauz sie bei jedem Start auf
# 0600/0700 setzt (store.Open, blob, config.RestrictPermissions); zwei
# Nutzer mit gemeinsamer Gruppe gehen erst nach einer Code-Änderung.
# Deshalb trennt die Unit selbst: eigener PID-Namensraum (PrivatePIDs=, ab
# systemd 257; dann sieht der Dienst die Prozesse des Sync-Dienstes nicht),
# Passwortdateien und Credentials unsichtbar (InaccessiblePaths=). Ältere
# systemd-Versionen melden PrivatePIDs= als unbekannt und ignorieren es;
# dann sieht dieser Dienst die Prozesse desselben Nutzers in /proc
# (ProtectProc=invisible verbirgt nur fremde Nutzer). Das Passwort steht
# trotzdem nicht in /proc/<pid>/environ (es kommt als Credential), und
# jeder PostKauz-Prozess setzt unter Linux als erste Anweisung
# PR_SET_DUMPABLE=0 (internal/procguard): /proc/<pid>/mem und ptrace nur
# für root. Restrisiko ohne PrivatePIDs: Kindprozesse des Syncs
# (pdftotext, DOCX-Extraktor) sperren sich nicht; über ihr
# /proc/<pid>/root wäre die Credential-Datei lesbar, und ein vor der
# ersten Anweisung geöffnetes /proc/<pid>/mem bleibt erreichbar. Für den
# VPS deshalb systemd >= 257 oder zwei Systemnutzer. Restrisiko auch
# mit PrivatePIDs: Wer diesen Dienst übernimmt, kann über die
# gemeinsame Datenbank accounts.host ändern und den Sync beim nächsten
# Lauf an einen fremden Server schicken (docs/betrieb.md 4.4, Roadmap:
# zwei Systemnutzer).
#
#   install -Dm644 postkauz-mcp-http.service -t /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now postkauz-mcp-http.service
#   curl -sS -o /dev/null -w '%{http_code}\n' http://127.0.0.1:8787/healthz   # erwartet: 204
[Unit]
Description=PostKauz MCP over HTTP (no mailbox credentials)
Documentation=https://github.com/KNUFFIXX/postkauz/blob/main/docs/betrieb.md
After=network.target

[Service]
Type=simple
User=postkauz
Group=postkauz
Environment=POSTKAUZ_CONFIG=/etc/postkauz/config.toml
Environment=POSTKAUZ_DATA_DIR=/var/lib/postkauz
ExecStart=/usr/local/bin/postkauz mcp --http
Restart=on-failure
RestartSec=10
StateDirectory=postkauz
StateDirectoryMode=0700
UMask=0077
# Passwortdateien und Credentials der Sync-Dienste (LoadCredential=, als
# derselbe Nutzer sonst lesbar) gibt es in diesem Dienst nicht.
InaccessiblePaths=-/etc/postkauz/credentials
InaccessiblePaths=-/run/credentials
# Eigener PID-Namensraum (systemd 257 und neuer): keine fremden Prozesse,
# also auch nicht /proc/<pid>/environ von postkauz-sync@.
PrivatePIDs=yes
ProtectProc=invisible
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
