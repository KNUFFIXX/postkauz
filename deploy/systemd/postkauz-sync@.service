# PostKauz: Dauerläufer je Konto (sync --watch), Vorlage für einen VPS
# (A03 S3.5, E9). Nur dieser Dienst kennt die Zugangsdaten; der HTTP-MCP
# (postkauz-mcp-http.service) läuft ohne. Anleitung: docs/betrieb.md,
# Abschnitt „VPS“.
#
# Als System-Unit für den Nutzer postkauz (root richtet ein):
#   install -Dm644 postkauz-sync@.service -t /etc/systemd/system/
#   install -d -m 0750 -o root -g postkauz /etc/postkauz
#   install -d -m 0700 -o root -g root /etc/postkauz/credentials
#   install -d -m 0700 -o root -g root /etc/postkauz/credentials/sync-<konto>
#   install -m 0600 -o root -g root /dev/null /etc/postkauz/credentials/sync-<konto>/PASSWORD_<KONTO>
#   # in die Datei nur das Passwort (Dateiname in Großbuchstaben, "-" wird
#   # "_"; Konto demo-1 → PASSWORD_DEMO_1; ein Zeilenumbruch am Ende zählt nicht)
#
# Das Passwort kommt NICHT über die Umgebung (zweite Nachbesserung T5,
# Punkt 4): EnvironmentFile= stand in /proc/<pid>/environ. systemd liest den
# Ordner als root (LoadCredential=, Verzeichnisform ab systemd 251) und
# legt jede Datei als Credential POSTKAUZ_<DATEINAME> nur für diesen Dienst
# in $CREDENTIALS_DIRECTORY (/run/credentials/<unit>, nicht auslagerbarer
# Speicher, lesbar nur für den Nutzer postkauz); PostKauz liest daraus
# POSTKAUZ_PASSWORD_<KONTO>. Der HTTP-MCP sieht /run/credentials und
# /etc/postkauz/credentials nicht (InaccessiblePaths=). Ältere systemd
# (249/250, etwa Ubuntu 22.04): statt der Zeile unten je Konto ein Drop-in
# mit der Einzeldatei, docs/betrieb.md 4.4.
#   systemctl daemon-reload
#   systemctl enable --now postkauz-sync@<konto>.service
#   journalctl -u postkauz-sync@<konto>.service
#
# %i ist der Kontoname (z. B. postkauz-sync@<konto>.service, also für das Konto privat: privat statt <konto>).
# Programm unter /usr/local/bin/postkauz, Daten unter /var/lib/postkauz,
# Konfiguration unter /etc/postkauz/config.toml.
[Unit]
Description=PostKauz sync --watch for account %i (holds the mailbox credentials)
Documentation=https://github.com/KNUFFIXX/postkauz/blob/main/docs/betrieb.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=postkauz
Group=postkauz
# Zugangsdaten nur hier (Ordner 0700, Datei 0600, root:root; liest systemd
# als root); nie in der Unit selbst und nie in der Umgebung.
LoadCredential=POSTKAUZ:/etc/postkauz/credentials/sync-%i
Environment=POSTKAUZ_CONFIG=/etc/postkauz/config.toml
Environment=POSTKAUZ_DATA_DIR=/var/lib/postkauz
ExecStart=/usr/local/bin/postkauz sync --watch -a %i
Restart=on-failure
RestartSec=60
# Nach einer abgelehnten Anmeldung (Exit-Code 6) nicht sofort neu: der
# Anbieter könnte das Konto sperren.
RestartPreventExitStatus=6
StateDirectory=postkauz
StateDirectoryMode=0700
UMask=0077
# /proc zeigt nur Prozesse desselben Nutzers.
ProtectProc=invisible
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
