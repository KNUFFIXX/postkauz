root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.sql]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.ps1]
# Windows PowerShell 5.1 liest Skripte ohne BOM als ANSI
charset = utf-8-bom
end_of_line = crlf
indent_size = 4
